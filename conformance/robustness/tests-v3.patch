+// MutexAcquire is concurrency.Mutex's tryAcquire, as Talos takes it: if myKey
+// does not exist, put it under the session lease; either way read the owner, the
+// prefix's first key by create revision.
+func (c *RecordingClient) MutexAcquire(ctx context.Context, pfx, myKey, value string, lease int64) (*clientv3.TxnResponse, error) {
+	cmp := clientv3.Compare(clientv3.CreateRevision(myKey), "=", 0)
+	put := clientv3.OpPut(myKey, value, clientv3.WithLease(clientv3.LeaseID(lease)))
+	get := clientv3.OpGet(myKey)
+	getOwner := clientv3.OpGet(pfx, clientv3.WithFirstCreate()...)
+	owner := model.EtcdOperation{Type: model.RangeOperation, Range: model.RangeOptions{
+		Start: pfx, End: clientv3.GetPrefixRangeEnd(pfx), Limit: 1, SortCreate: "ascend",
+	}}
+	request := model.EtcdRequest{Type: model.Txn, Txn: &model.TxnRequest{
+		Conditions: []model.EtcdCondition{{Key: myKey, CompareCreate: true}},
+		OperationsOnSuccess: []model.EtcdOperation{
+			{Type: model.PutOperation, Put: model.PutOptions{Key: myKey, Value: model.ToValueOrHash(value), LeaseID: lease}},
+			owner,
+		},
+		OperationsOnFailure: []model.EtcdOperation{
+			{Type: model.RangeOperation, Range: model.RangeOptions{Start: myKey}},
+			owner,
+		},
+	}}
+	c.kvMux.Lock()
+	defer c.kvMux.Unlock()
+	callTime := time.Since(c.baseTime)
+	resp, err := c.client.Txn(ctx).If(cmp).Then(put, getOwner).Else(get, getOwner).Commit()
+	returnTime := time.Since(c.baseTime)
+	c.kvOperations.AppendModelTxn(request, callTime, returnTime, resp, err)
+	return resp, err
+}
+
+// MutexWaiters is concurrency.Mutex's waitDeletes read: the newest key in the
+// prefix created before maxCreateRev.
+func (c *RecordingClient) MutexWaiters(ctx context.Context, pfx string, maxCreateRev int64) (*clientv3.GetResponse, error) {
+	opts := append(clientv3.WithLastCreate(), clientv3.WithMaxCreateRev(maxCreateRev))
+	request := model.EtcdRequest{Type: model.Range, Range: &model.RangeRequest{RangeOptions: model.RangeOptions{
+		Start: pfx, End: clientv3.GetPrefixRangeEnd(pfx), Limit: 1, SortCreate: "descend", MaxCreateRevision: maxCreateRev,
+	}}}
+	c.kvMux.Lock()
+	defer c.kvMux.Unlock()
+	callTime := time.Since(c.baseTime)
+	resp, err := c.client.Get(ctx, pfx, opts...)
+	returnTime := time.Since(c.baseTime)
+	c.kvOperations.AppendModelRange(request, callTime, returnTime, resp, err)
+	return resp, err
+}
+
 func (c *RecordingClient) Txn(ctx context.Context) clientv3.Txn {
 	return &wrappedTxn{txn: c.client.Txn(ctx), c: c}
 }
